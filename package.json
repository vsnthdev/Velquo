{
    "name": "velquo",
    "description": "A fast, native Apple Silicon client for KDE Connect — seamlessly bridging Android and Linux devices with your Mac.",
    "private": true,
    "version": "1.2.0",
    "homepage": "https://github.com/vsnthdev/Velquo",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "bun check && vite build",
        "lint": "eslint --fix . && cargo fmt --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
        "preview": "vite preview",
        "tauri": "tauri",
        "bundle": "tauri build --bundles app,dmg",
        "icons": "bun run scripts/icons-generate.ts"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-popover": "^1.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/api": "^2.5.0",
        "@tauri-apps/plugin-autostart": "^2.7.0",
        "@tauri-apps/plugin-dialog": "^2.2.1",
        "@tauri-apps/plugin-opener": "^2.2.6",
        "@tauri-apps/plugin-updater": "^2.14.0",
        "motion": "^14.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@resvg/resvg-js": "^2.6.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tauri-apps/cli": "^2.5.0",
        "@types/bun": "^1.4.4",
        "@types/prompts": "^2.4.9",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "prompts": "^2.4.2",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.4"
    }
}
